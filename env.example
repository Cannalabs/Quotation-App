# Database Configuration
# IMPORTANT: Use URL encoding for special characters in passwords (e.g., @ becomes %40)
# Example: password "root@123" becomes "root%40123"
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://growuser:YOUR_PASSWORD@YOUR_DB_HOST:5432/grow

# CORS Configuration
# For production: use your actual domain(s)
# For development: use localhost ports
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://YOUR_SERVER_IP

# Company Settings
DEFAULT_COMPANY_NAME=Your Company Name
DEFAULT_VAT_RATE=4.00

# Quotation Settings
QUOTATION_PREFIX=QUO
QUOTATION_NUMBER_FORMAT={prefix}{year}/{id:04d}

# Timeout Settings
DEFAULT_TIMEOUT=3000
UPLOAD_TIMEOUT=4000
TOAST_TIMEOUT=5000

# File Upload
MAX_FILE_SIZE_MB=5

# Quote Validity
DEFAULT_QUOTE_VALIDITY_DAYS=30

# Email Configuration (SMTP)
MAIL_USERNAME=YOUR_SMTP_USER
MAIL_PASSWORD=YOUR_SMTP_PASS
MAIL_FROM=you@yourdomain.com
MAIL_FROM_NAME=Grow United Italy
MAIL_PORT=587
MAIL_SERVER=smtp.yourprovider.com
MAIL_TLS=true
MAIL_SSL=false
MAIL_USE_CREDENTIALS=true

# JWT Authentication (REQUIRED for production)
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-change-in-production
